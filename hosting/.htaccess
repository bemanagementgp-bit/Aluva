# Sitio público de Aluva (aluva.com.ar) — exportación estática de Next.js.
# Este archivo lo genera el repo (hosting/.htaccess) y lo copia `npm run hosting` a out/.
# El acceso y la app viven en app.aluva.com.ar y no dependen de nada de esta carpeta.

Options -Indexes -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # La copia de seguridad del sitio anterior (_viejo/) no se sirve
  RewriteRule ^_viejo(/|$) - [F,L]

  # La PWA vieja arrancaba en /login: ahora el acceso está en app.aluva.com.ar
  RewriteRule ^login/?$ https://app.aluva.com.ar/ [R=302,L]

  # Direcciones de la landing anterior (index.php) y del sitio en HTML
  RewriteRule ^(templados|blindex|vidriosymamparas)(\.html)?/?$ /vidrieria [R=301,L]
  RewriteRule ^revestimiento(\.html)?/?$ /revestimientos [R=301,L]
  RewriteRule ^index\.php$ / [R=301,L]

  # /pagina.html -> /pagina (solo si lo pidió el navegador, no en subpedidos internos)
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s/+index\.html[\s?]
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s/+([a-z-]+)\.html[\s?]
  RewriteRule ^([a-z-]+)\.html$ /$1 [R=301,L]

  # /pagina/ -> /pagina
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /pagina sirve pagina.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^.]+)$ $1.html [L]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddCharset UTF-8 .html .css .js .svg .txt .xml
</IfModule>

<IfModule mod_headers.c>
  # Los archivos de _next/static llevan hash en el nombre: pueden cachearse para siempre
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
